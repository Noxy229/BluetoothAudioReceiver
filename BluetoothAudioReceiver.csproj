<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.3.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Authors>Noxy</Authors>
    <Company>Noxy</Company>
    <Product>Bluetooth Audio Receiver</Product>
    <AssemblyName>BluetoothAudioReceiver</AssemblyName>
    <RootNamespace>BluetoothAudioReceiver</RootNamespace>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Desktop/**/*.cs;tests/**/*.cs" />
    <EmbeddedResource Remove="Desktop/**;tests/**" />
    <None Remove="Desktop/**;tests/**" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>
