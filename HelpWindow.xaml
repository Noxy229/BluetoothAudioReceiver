<Window x:Class="BluetoothAudioReceiver.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title=""
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent">

    <Border Background="{StaticResource BackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="❓" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TitleTextBlock"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <Button x:Name="CloseButton"
                            Content="✕"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseButtonStyle}"
                            HorizontalAlignment="Right"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                <StackPanel>

                    <!-- Quick Start -->
                    <TextBlock x:Name="QuickStartHeader" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <TextBlock x:Name="QuickStartStepsText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Margin="0,0,0,12"/>
                    </Border>

                    <!-- Known Issues -->
                    <TextBlock x:Name="KnownIssuesHeader" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <StackPanel>

                            <!-- Issue 1 -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="NetworkSlowdownHeader"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBlock x:Name="NetworkSlowdownDescText"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12"/>
                                <Border Background="{StaticResource SurfaceVariantBrush}"
                                        CornerRadius="6"
                                        Padding="12"
                                        Margin="0,8,0,0">
                                    <TextBlock x:Name="NetworkSolutionText"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <!-- Issue 2 -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock x:Name="NoDevicesIssueHeader"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,6"/>
                                <Border Background="{StaticResource SurfaceVariantBrush}"
                                        CornerRadius="6"
                                        Padding="12">
                                    <TextBlock x:Name="NoDevicesSolutionText"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </Border>
                            </StackPanel>

                            <!-- Issue 3 -->
                            <StackPanel>
                                <TextBlock x:Name="ConnectionDropsHeader"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource WarningBrush}"
                                           Margin="0,0,0,6"/>
                                <Border Background="{StaticResource SurfaceVariantBrush}"
                                        CornerRadius="6"
                                        Padding="12">
                                    <TextBlock x:Name="ConnectionDropsSolutionText"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="12"/>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- System Requirements -->
                    <TextBlock x:Name="SystemRequirementsHeader" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                        <TextBlock x:Name="RequirementsText"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                    </Border>

                    <!-- Version Info -->
                    <TextBlock x:Name="InfoHeader" Style="{StaticResource SectionHeaderStyle}"/>
                    <Border Style="{StaticResource CardStyle}">
                        <TextBlock x:Name="VersionInfoText"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="12"/>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
